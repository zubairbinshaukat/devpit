---
// Starlight's page title, plus a way back on blog pages. The blog swaps the
// docs sidebar for its own list of posts (and on a phone the sidebar is behind
// the menu button), so each blog page starts with "Back to docs" and, on a
// post, "All posts".
//
// Every other page (not the docs home, the blog or the 404) starts with a
// visible breadcrumb trail. It is the same trail routeData.ts writes as
// BreadcrumbList JSON-LD: Devpit > Docs > parent section (when it is a real
// page) > this page.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { getEntry } from 'astro:content';

import { BASE } from '../../site.config.mjs';
import { hrefFor } from '../lib/href';

const { id, entry } = Astro.locals.starlightRoute;
const isBlog = id === 'blog' || id.startsWith('blog/');
const isPost = isBlog && !/^blog(\/(\d+|tags\/.+|authors\/.+))?$/.test(id);

// The docs home has an empty id at render time but is content id "index".
const contentId = entry.id === '' ? 'index' : entry.id;
const crumbs: { label: string; href?: string }[] = [];
if (!isBlog && contentId !== 'index' && contentId !== '404') {
  crumbs.push({ label: 'Devpit', href: '/' }, { label: 'Docs', href: BASE });
  const parts = contentId.replace(/\/index$/, '').split('/');
  for (let i = 1; i < parts.length; i++) {
    const parentId = parts.slice(0, i).join('/');
    const parent = await getEntry('docs', parentId);
    if (parent) crumbs.push({ label: String(parent.data.title), href: hrefFor(parentId) });
  }
  crumbs.push({ label: String(entry.data.title) });
}
---

{
  crumbs.length > 0 && (
    <nav class="dp-crumbs" aria-label="Breadcrumb">
      <ol>
        {crumbs.map((c) => (
          <li aria-current={c.href ? undefined : 'page'}>
            {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>
  )
}
{
  isBlog && (
    <nav class="dp-back" aria-label="Back">
      <a href={BASE} class="dp-back__link">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M10 3.5 5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back to docs
      </a>
      {isPost && (
        <a href={`${BASE}/blog`} class="dp-back__link dp-back__link--quiet">
          All posts
        </a>
      )}
    </nav>
  )
}
<Default {...Astro.props} />

<style>
  .dp-crumbs {
    margin-bottom: 0.75rem;
    font-size: var(--sl-text-sm);
  }
  .dp-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dp-crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    color: var(--sl-color-gray-2);
  }
  .dp-crumbs li + li::before {
    content: '/';
    color: var(--sl-color-gray-3);
  }
  .dp-crumbs a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .dp-crumbs a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
  .dp-crumbs li[aria-current='page'] span {
    max-width: min(32rem, 100%);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dp-back {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .dp-back__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--dp-border);
    border-radius: 999px;
    background: var(--dp-surface);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--dp-fast) var(--dp-ease),
      background-color var(--dp-fast) var(--dp-ease),
      box-shadow var(--dp-fast) var(--dp-ease);
  }
  .dp-back__link:hover {
    border-color: color-mix(in oklab, var(--sl-color-accent-high) 45%, var(--dp-border));
    background: var(--dp-tint);
    box-shadow: var(--dp-ring);
  }
  .dp-back__link svg {
    transition: transform var(--dp-fast) var(--dp-ease);
  }
  .dp-back__link:hover svg {
    transform: translateX(-2px);
  }
  .dp-back__link--quiet {
    padding-inline: 0.85rem;
    color: var(--sl-color-gray-2);
    font-weight: 500;
  }
</style>
