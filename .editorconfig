# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1}]
end_of_line = crlf
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[testdata/golden/*.golden]
# Golden files are byte-exact renders. Nothing may touch them.
trim_trailing_whitespace = false
insert_final_newline = false
